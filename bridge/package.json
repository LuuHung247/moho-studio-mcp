{
  "name": "moho-studio-mcp",
  "version": "1.5.0",
  "description": "MCP server that lets an AI build characters, rigs, animation and films in Moho Pro 14",
  "main": "dist/index.js",
  "bin": {
    "moho-studio-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "node scripts/gen-tool-reference.mjs",
    "lua-test": "lua ../moho-plugin/tests/run_tests.lua",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepack": "node scripts/prepack.mjs && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0",
    "vitest": "^5.1.1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "plugin",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuuHung247/moho-studio-mcp.git"
  },
  "keywords": [
    "mcp",
    "moho",
    "animation",
    "codex",
    "claude"
  ]
}
